# livekit (installed by ubuntu_provision.sh step 48c)
check process livekit matching /usr/local/bin/livekit-server
  group livekit
  start program = "/usr/bin/systemctl start livekit" with timeout 60 seconds
  stop program  = "/usr/bin/systemctl stop livekit" with timeout 60 seconds
  if failed host 127.0.0.1 port 7880 protocol http request "/" with timeout 10 seconds for 3 times within 4 cycles then restart
  if totalmem > 1500 Mb then alert
  if totalmem > 3000 Mb then restart
  if cpu > 80% for 5 cycles then alert
  if 2 restarts within 3 cycles then alert
  depend livekit_bin

check file livekit_bin with path /usr/local/bin/livekit-server
  group livekit
  include /etc/monit/templates/rootbin
