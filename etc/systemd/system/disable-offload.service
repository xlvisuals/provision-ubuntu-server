[Unit]
Description=Disable TCP Transmit Offloading
# Wait for the interface itself: network.target alone can be reached before it exists at boot.
BindsTo=sys-subsystem-net-devices-%%PRIMARY_INTERFACE_UNIT%%.device
After=sys-subsystem-net-devices-%%PRIMARY_INTERFACE_UNIT%%.device network.target

[Service]
Type=oneshot
ExecStart=/sbin/ethtool -K %%PRIMARY_INTERFACE%% tx off
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
